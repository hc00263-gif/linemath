# Copy this file to .env.local and fill in your real key.
# .env.local is already gitignored — it will never be committed.

# api-sports.io account key (Dashboard -> My Access -> API-KEY).
# One key works across every api-sports.io product you've subscribed to
# (API-NBA, API-NFL, API-Hockey, API-Baseball).
API_SPORTS_KEY=

# --- Sports news monitoring (Tier 1) ---

# OpenRouter API key, used to classify incoming news items as "major" vs routine
# with a free-tier (":free") model. Get one at https://openrouter.ai/keys.
# Free tier is capped at 50 requests/day; a one-time $10 credit purchase raises
# that to 1,000/day, needed for 5-minute polling.
OPENROUTER_API_KEY=

# Upstash Redis (REST API) — used to store and dedupe news items.
# Create a free database at https://console.upstash.com and copy these from
# its "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret checked against the `x-news-ingest-secret` header on
# POST /api/news/ingest. Generate any long random string; put the same value
# in the GitHub Actions repo secret NEWS_INGEST_SECRET.
NEWS_INGEST_SECRET=
