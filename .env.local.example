# Copy this file to .env.local and fill in your real key.
# .env.local is already gitignored — it will never be committed.

# api-sports.io account key (Dashboard -> My Access -> API-KEY).
# One key works across every api-sports.io product you've subscribed to
# (API-NBA, API-NFL, API-Hockey, API-Baseball).
API_SPORTS_KEY=
